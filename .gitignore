# binarios y salidas: los zip van como Release de GitHub, no dentro del repositorio
_release/
*.zip
**/dist/
**/build/
**/__pycache__/
*.spec
# herramientas de terceros (ODA File Converter no se puede redistribuir)
proyectos/*/herramientas/
# resultados de pruebas
**/salida*/
*.dxf
*.dwg
# planos reales: nunca subir
proyectos/editorpdf/*.pdf
!proyectos/editorpdf/ejemplo/*.pdf
.firebase/
node_modules/

# lista local de nombres que no deben salir en las copias publicas
.bloqueo-local.txt
